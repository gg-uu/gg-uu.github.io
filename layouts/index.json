{{- $pages := where site.RegularPages "Type" "posts" -}}
[
{{- range $i, $p := $pages -}}
  {{- if $i }},{{ end }}
  {
    "title": {{ $p.Title | jsonify }},
    "url": {{ $p.Permalink | jsonify }},
    "date": {{ $p.Date.Format "2006-01-02" | jsonify }},
    "summary": {{ (or $p.Description $p.Summary) | plainify | truncate 300 | jsonify }},
    "content": {{ $p.Plain | truncate 2000 | jsonify }},
    "tags": {{ with $p.Params.tags }}{{ . | jsonify }}{{ else }}[]{{ end }},
    "categories": {{ with $p.Params.categories }}{{ . | jsonify }}{{ else }}[]{{ end }}
  }
{{- end -}}
]
